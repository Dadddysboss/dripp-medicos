# =============================================================================
# Dripp Medicos — Environment Variables Template
# =============================================================================
# Copy this file to `.env` (for local Node helper scripts) or paste the values
# into the Vercel Project Settings → Environment Variables dashboard.
#
# The in-app GitHub Sync Settings panel is the primary configuration surface
# for end users. These variables are only consumed by:
#   - scripts/init-repo.js   (local validation)
#   - scripts/deploy.js      (optional CI helper)
#   - any future build pipeline that pre-reads credentials at build-time
#
# Generate a Fine-Grained Personal Access Token at:
#   https://github.com/settings/tokens?type=beta
# Required permissions on the target repository:
#   - Contents: Read and Write
# =============================================================================

# ---- Primary (Vite / modern bundlers) ----
VITE_GITHUB_TOKEN=
VITE_GITHUB_REPO=your-username/dripp-medicos
VITE_GITHUB_BRANCH=main

# ---- Aliases (consumed by Node helper scripts and CI) ----
GH_TOKEN=
GH_REPO=your-username/dripp-medicos
GH_BRANCH=main

# ---- Optional ----
# Default cashier name shown in the header before the user customises it.
# VITE_DEFAULT_CASHIER=Front Desk
#
# Default brand accent colour (must be a valid Tailwind colour name).
# VITE_BRAND_ACCENT=teal
